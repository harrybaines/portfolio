---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Testimonial from '../../components/Testimonial.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Components available in MDX
const components = { Testimonial };

// Calculate reading time
const wordsPerMinute = 225;
const wordCount = post.body.trim().split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / wordsPerMinute));

// Format date
const formatDate = (dateStr: string) => {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
};
---

<Layout title={`${post.data.title} | Harry Baines`} description={post.data.description}>
  <div class="pt-32 pb-12 max-w-3xl mx-auto px-8">
    <header class="mb-16 relative">
      <div class="mb-12">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm !text-[#a3a3a3] hover:!text-[var(--foreground)] transition-colors"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m12 19-7-7 7-7"></path>
            <path d="M19 12H5"></path>
          </svg>
          Back
        </a>
      </div>
      <div class="flex justify-center">
        <p class="text-sm">
          {formatDate(post.data.publishedAt)} — {readingTime} min read
        </p>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold text-center mt-3 text-neutral-900 dark:text-neutral-300">
        {post.data.title}
      </h1>
    </header>

    <div class="mb-60 prose">
      <Content components={components} />
    </div>
  </div>
</Layout>
