---
import Layout from '../layouts/Layout.astro';

const externalLinks = [
  { href: 'https://unsplash.com/@harrybaines', label: 'Wallpapers' },
  { href: 'https://tiktok.com/@harrybaines', label: 'TikTok' },
  { href: 'https://x.com/harrybaines', label: 'X' },
];
---

<Layout>
  <!-- Full Site View -->
  <div id="full-site" class="min-h-screen w-full pt-48 pb-16">
    <div class="max-w-5xl mx-auto px-8">
      <!-- Asymmetric Grid Layout -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        <!-- Main Content - Offset Column -->
        <div class="md:col-start-1 md:col-span-8 space-y-12">
          <div class="animate-fade-in-up">
            <h1 class="text-7xl md:text-8xl font-semibold leading-none mb-8">
              Harry
              <br />
              Baines
            </h1>

            <div class="space-y-4 text-xl leading-relaxed max-w-xl">
              <p>
                AI Integration · LLMs · Full Stack Development
              </p>
            </div>
          </div>

          <!-- Now Section -->
          <div class="space-y-4 animate-fade-in-up animation-delay-100">
            <h2 class="text-sm font-mono uppercase tracking-wider !text-[#a3a3a3]">
              Now
            </h2>
            <div class="space-y-3 text-base max-w-xl">
              <p>
                Software Engineer at{" "}
                <a
                  href="https://connexai.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline underline-offset-2 hover:!text-[var(--foreground)] transition-colors"
                >
                  ConnexAI
                </a>, building AI-powered tools and integrations. I work across the stack—from backend services and APIs to frontend interfaces—with a focus on LLM applications and developer tooling.
              </p>
              <p>
                Interested in agentic systems, RAG pipelines, and making AI more useful for everyday workflows.
              </p>
            </div>
          </div>

          <!-- Work Section -->
          <div class="space-y-6 animate-fade-in-up animation-delay-200">
            <h2 class="text-sm font-mono uppercase tracking-wider !text-[#a3a3a3]">
              Selected Work
            </h2>
            <div class="space-y-2">
              <a
                href="https://github.com/harrybaines"
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center justify-between py-3 border-b border-[var(--gray-200)] hover:border-[#a3a3a3] transition-colors"
              >
                <div>
                  <span class="text-base !text-[var(--foreground)] group-hover:!text-[var(--foreground)] transition-colors">
                    AI Code Assistant
                  </span>
                  <span class="text-sm !text-[#a3a3a3] ml-2">
                    LLM-powered CLI tool for code generation
                  </span>
                </div>
                <span class="text-sm font-mono !text-[#d4d4d4] group-hover:!text-[#a3a3a3] transition-colors">
                  →
                </span>
              </a>
              <a
                href="https://github.com/harrybaines"
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center justify-between py-3 border-b border-[var(--gray-200)] hover:border-[#a3a3a3] transition-colors"
              >
                <div>
                  <span class="text-base !text-[var(--foreground)] group-hover:!text-[var(--foreground)] transition-colors">
                    RAG Pipeline
                  </span>
                  <span class="text-sm !text-[#a3a3a3] ml-2">
                    Document Q&A with semantic search
                  </span>
                </div>
                <span class="text-sm font-mono !text-[#d4d4d4] group-hover:!text-[#a3a3a3] transition-colors">
                  →
                </span>
              </a>
              <a
                href="https://github.com/harrybaines"
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center justify-between py-3 border-b border-[var(--gray-200)] hover:border-[#a3a3a3] transition-colors"
              >
                <div>
                  <span class="text-base !text-[var(--foreground)] group-hover:!text-[var(--foreground)] transition-colors">
                    Agent Framework
                  </span>
                  <span class="text-sm !text-[#a3a3a3] ml-2">
                    Multi-agent orchestration system
                  </span>
                </div>
                <span class="text-sm font-mono !text-[#d4d4d4] group-hover:!text-[#a3a3a3] transition-colors">
                  →
                </span>
              </a>
            </div>

            <!-- External Links -->
            <div class="flex flex-wrap gap-3 pt-4">
              {externalLinks.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-[var(--gray-200)] !text-[#525252] text-sm hover:border-[#a3a3a3] hover:!text-[var(--foreground)] transition-colors"
                >
                  {link.label}
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 17L17 7"></path>
                    <path d="M7 7h10v10"></path>
                  </svg>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Right Column - Meta Info -->
        <div class="md:col-start-10 md:col-span-3 space-y-8 animate-fade-in-up animation-delay-300">
          <div class="space-y-2">
            <p class="text-sm font-mono uppercase tracking-wider !text-[#a3a3a3]">Location</p>
            <p>🇬🇧 United Kingdom</p>
          </div>
          <div class="space-y-2">
            <p class="text-sm font-mono uppercase tracking-wider !text-[#a3a3a3]">Connect</p>
            <div class="space-y-1">
              <a
                href="https://github.com/harrybaines"
                target="_blank"
                rel="noopener noreferrer"
                class="block text-sm w-fit px-2 py-0.5 -ml-2 rounded hover:bg-[var(--gray-100)] transition-colors"
              >
                GitHub
              </a>
              <a
                href="https://linkedin.com/in/harrybaines"
                target="_blank"
                rel="noopener noreferrer"
                class="block text-sm w-fit px-2 py-0.5 -ml-2 rounded hover:bg-[var(--gray-100)] transition-colors"
              >
                LinkedIn
              </a>
              <a
                href="mailto:harry@example.com"
                class="block text-sm w-fit px-2 py-0.5 -ml-2 rounded hover:bg-[var(--gray-100)] transition-colors"
              >
                Email
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Toggle to Minimal Button -->
    <button
      id="show-minimal"
      class="fixed bottom-8 right-8 px-4 py-2 bg-[#1a1a1a] text-white text-sm rounded-full hover:bg-[#333] transition-colors flex items-center gap-2"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="1"></circle>
        <circle cx="12" cy="5" r="1"></circle>
        <circle cx="12" cy="19" r="1"></circle>
      </svg>
      See minimal site
    </button>
  </div>

  <!-- Minimal Site View -->
  <div id="minimal-site" class="hidden min-h-screen w-full bg-white flex items-center px-12 md:px-24 lg:px-48">
    <div class="max-w-4xl">
      <h1 class="text-6xl md:text-8xl font-black tracking-tight text-[#1a1a1a] leading-[0.9]" style="font-family: 'Inter', sans-serif;">
        HARRY
        <br />
        BAINES
      </h1>

      <p class="mt-12 text-sm tracking-widest text-[#1a1a1a] uppercase">
        Software Engineer · UK · AI Integration · LLMs · Full Stack
      </p>

      <div class="mt-16 flex flex-wrap items-center gap-8 md:gap-16">
        <a
          href="https://github.com/harrybaines"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 text-[#1a1a1a] hover:opacity-70 transition-opacity"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          <span class="underline underline-offset-4">GitHub</span>
        </a>

        <a
          href="https://linkedin.com/in/harrybaines"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 text-[#1a1a1a] hover:opacity-70 transition-opacity"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          <span class="underline underline-offset-4">LinkedIn</span>
        </a>

        <a
          href="mailto:harry@example.com"
          class="flex items-center gap-3 text-[#1a1a1a] hover:opacity-70 transition-opacity"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          <span class="underline underline-offset-4">Email</span>
        </a>
      </div>
    </div>

    <!-- Toggle to Full Site Button -->
    <button
      id="show-full"
      class="fixed bottom-8 right-8 px-4 py-2 bg-[#1a1a1a] text-white text-sm rounded-full hover:bg-[#333] transition-colors flex items-center gap-2"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m12 19-7-7 7-7"></path>
        <path d="M19 12H5"></path>
      </svg>
      See full site
    </button>
  </div>

  <script>
    const fullSite = document.getElementById('full-site');
    const minimalSite = document.getElementById('minimal-site');
    const showMinimalBtn = document.getElementById('show-minimal');
    const showFullBtn = document.getElementById('show-full');
    const navbar = document.querySelector('nav');

    showMinimalBtn?.addEventListener('click', () => {
      fullSite?.classList.add('hidden');
      minimalSite?.classList.remove('hidden');
      navbar?.classList.add('hidden');
    });

    showFullBtn?.addEventListener('click', () => {
      minimalSite?.classList.add('hidden');
      fullSite?.classList.remove('hidden');
      navbar?.classList.remove('hidden');
    });
  </script>
</Layout>
