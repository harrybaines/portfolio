---
import Layout from '../layouts/Layout.astro';

const projects = [
  { name: 'brewkit', description: 'CLI toolkit for developers', href: 'https://github.com/harrybaines' },
  { name: 'dotfiles', description: 'Personal config files', href: 'https://github.com/harrybaines/dotfiles' },
  { name: 'promptlab', description: 'LLM prompt testing', href: 'https://github.com/harrybaines' },
];

const contacts = [
  { label: 'X', href: 'https://x.com/harrybaines', icon: 'x' },
  { label: 'GitHub', href: 'https://github.com/harrybaines', icon: 'github' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/harrybaines', icon: 'linkedin' },
  { label: 'Email', href: 'mailto:harry@harrybaines.net', icon: 'email' },
];
---

<Layout>
  <div class="min-h-screen pt-16 md:pt-24 pb-16">
    <div class="max-w-6xl mx-auto px-8 lg:px-16">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-16 lg:gap-24">
        <!-- Main Content -->
        <div class="space-y-12">
          <!-- Name -->
          <div class="animate-fade-in-up">
            <h1 class="text-6xl md:text-7xl lg:text-8xl font-normal leading-[0.95] tracking-tight text-[var(--foreground)]">
              Harry<br />Baines
            </h1>
          </div>

          <!-- Description -->
          <div class="animate-fade-in-up animation-delay-100">
            <p class="text-lg md:text-xl leading-relaxed text-[var(--text-secondary)] max-w-xl">
              Software engineer focused on AI integration, large language models, and full stack development.
            </p>
          </div>

          <!-- Now Section -->
          <div class="space-y-4 animate-fade-in-up animation-delay-200">
            <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[var(--text-secondary)]">
              Now
            </h2>
            <p class="text-lg leading-relaxed text-[var(--text-secondary)] max-w-xl">
              Currently working at{" "}
              <a
                href="https://connexai.com"
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--foreground)] underline underline-offset-4 decoration-[var(--text-secondary)] hover:decoration-[var(--foreground)] transition-colors"
              >
                ConnexAI
              </a>, exploring the intersection of AI and developer tooling. Building intelligent systems that bridge cutting-edge AI with practical web applications.
            </p>
          </div>

          <!-- Selected Work -->
          <div class="space-y-4 animate-fade-in-up animation-delay-300">
            <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[var(--text-secondary)]">
              Selected Work
            </h2>
            <div class="border-t border-[var(--border-color)]">
              {projects.map((project) => (
                <a
                  href={project.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-baseline gap-4 py-4 border-b border-[var(--border-color)] hover:bg-[var(--gray-100)] transition-colors -mx-2 px-2"
                >
                  <span class="text-base text-[var(--foreground)] font-normal">
                    {project.name}
                  </span>
                  <span class="text-[var(--text-secondary)]">—</span>
                  <span class="text-base text-[var(--text-secondary)]">
                    {project.description}
                  </span>
                </a>
              ))}
            </div>
          </div>

          <!-- Footer Text -->
          <div class="pt-8 animate-fade-in-up animation-delay-300">
            <p class="text-sm font-mono text-[var(--text-secondary)]">
              Consuming coffee and vibing with Claude
            </p>
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="space-y-8 lg:pt-4">
          <!-- Location -->
          <div class="space-y-3">
            <h3 class="text-xs font-mono uppercase tracking-[0.2em] text-[var(--text-secondary)]">
              Location
            </h3>
            <div class="flex items-center gap-2">
              <span class="text-base">🇬🇧</span>
              <span class="text-base text-[var(--text-secondary)]">United Kingdom</span>
            </div>
          </div>

          <!-- Contact -->
          <div class="space-y-3">
            <h3 class="text-xs font-mono uppercase tracking-[0.2em] text-[var(--text-secondary)]">
              Contact
            </h3>
            <div class="space-y-2">
              {contacts.map((contact) => (
                <a
                  href={contact.href}
                  target={contact.href.startsWith('mailto') ? undefined : '_blank'}
                  rel={contact.href.startsWith('mailto') ? undefined : 'noopener noreferrer'}
                  class="flex items-center gap-3 text-[var(--text-secondary)] hover:text-[var(--foreground)] transition-colors"
                >
                  {contact.icon === 'x' && (
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                    </svg>
                  )}
                  {contact.icon === 'github' && (
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                  )}
                  {contact.icon === 'linkedin' && (
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                  )}
                  {contact.icon === 'email' && (
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                    </svg>
                  )}
                  <span class="text-base">{contact.label}</span>
                </a>
              ))}
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</Layout>
