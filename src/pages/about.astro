---
import Layout from '../layouts/Layout.astro';

const stack = [
  'TypeScript',
  'React',
  'Next.js',
  'Python',
  'Node.js',
  'PostgreSQL',
];

const interests = [
  { label: 'Developer tools', icon: 'code' },
  { label: 'Good coffee', icon: 'coffee' },
  { label: 'Film photography', icon: 'camera' },
];
---

<Layout title="About | Harry Baines" description="Learn more about Harry Baines, a software engineer based in the UK specializing in AI integration and full-stack development.">
  <div class="min-h-screen pt-16 md:pt-24 pb-16">
    <div class="max-w-6xl mx-auto px-8 lg:px-16">
      <!-- Header -->
      <div class="mb-12">
        <span class="text-xs font-mono uppercase tracking-[0.2em] text-[var(--text-secondary)]">
          About
        </span>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-normal leading-[1.1] tracking-tight text-[var(--foreground)] mt-2">
          Nice to meet you
        </h1>
      </div>

      <!-- Two Column Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24">
        <!-- Left: Portrait -->
        <div class="space-y-4">
          <div class="aspect-[4/5] w-full max-w-md bg-[var(--gray-100)] flex flex-col items-center justify-center">
            <svg class="w-12 h-12 text-[var(--text-secondary)] opacity-50 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0ZM18.75 10.5h.008v.008h-.008V10.5Z" />
            </svg>
            <span class="text-xs font-mono uppercase tracking-[0.2em] text-[var(--text-secondary)]">Portrait</span>
          </div>
          <p class="text-sm text-[var(--text-secondary)]">UK · 2024</p>
        </div>

        <!-- Right: Content -->
        <div class="space-y-8">
          <!-- Bio -->
          <div class="space-y-6">
            <p class="text-lg leading-relaxed text-[var(--text-secondary)]">
              Software engineer based in the UK. I work at the intersection of AI and practical applications, building tools that feel intuitive and purposeful.
            </p>
            <p class="text-lg leading-relaxed text-[var(--text-secondary)]">
              My approach is minimal by nature. I believe the best interfaces disappear, leaving only the experience. Currently focused on LLM integration and developer tooling at ConnexAI.
            </p>
          </div>

          <!-- Interests -->
          <div class="space-y-4">
            <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[var(--text-secondary)]">
              Interests
            </h2>
            <div class="grid grid-cols-2 gap-3">
              {interests.map((interest) => (
                <div class="flex items-center gap-3 text-[var(--text-secondary)]">
                  {interest.icon === 'code' && (
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <polyline points="16 18 22 12 16 6"></polyline>
                      <polyline points="8 6 2 12 8 18"></polyline>
                    </svg>
                  )}
                  {interest.icon === 'coffee' && (
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path d="M17 8h1a4 4 0 1 1 0 8h-1"></path>
                      <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path>
                      <line x1="6" x2="6" y1="2" y2="4"></line>
                      <line x1="10" x2="10" y1="2" y2="4"></line>
                      <line x1="14" x2="14" y1="2" y2="4"></line>
                    </svg>
                  )}
                  {interest.icon === 'camera' && (
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"></path>
                      <circle cx="12" cy="13" r="3"></circle>
                    </svg>
                  )}
                  <span class="text-base">{interest.label}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Stack -->
          <div class="space-y-4">
            <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[var(--text-secondary)]">
              Stack
            </h2>
            <div class="flex flex-wrap gap-2">
              {stack.map((tech) => (
                <span class="px-3 py-1.5 border border-[var(--border-color)] text-sm font-mono text-[var(--text-secondary)]">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <!-- Footer Note -->
          <div class="pt-8 border-t border-[var(--border-color)]">
            <p class="text-sm font-mono text-[var(--text-secondary)] leading-relaxed">
              This site is set in IBM Plex, built with Next.js and Tailwind, and deployed on Vercel. Design inspired by editorial minimalism.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
