---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Page Not Found | Harry Baines">
  <div class="min-h-screen flex items-center justify-center">
    <div class="text-center">
      <h1 class="text-6xl font-bold mb-4">404</h1>
      <p class="text-xl !text-[var(--text-secondary)] mb-8">Page not found</p>
      <a
        href="/"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[var(--gray-200)] !text-[#525252] text-sm hover:border-[#a3a3a3] hover:!text-[var(--foreground)] transition-colors"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        Go home
      </a>
    </div>
  </div>
</Layout>
